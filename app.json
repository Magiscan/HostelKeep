{
  "expo": {
    "version": "1.1.0",
    "name": "HostelKeep",
    "slug": "hostelkeep",
    "orientation": "portrait",
    "scheme": "hostelkeep",
    "description": "Manage daily hostel room cleaning: assign rooms to cleaners, track progress in real time, and handle extra-room requests.",
    "primaryColor": "#0B1F3A",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hostelkeep.app",
      "buildNumber": "10",
      "infoPlist": {
        "NSCameraUsageDescription": "HostelKeep uses your camera to take a profile photo or a photo for an extra-room request.",
        "NSPhotoLibraryUsageDescription": "HostelKeep lets you choose a profile photo or hostel logo from your photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 10,
      "package": "com.hostelkeep.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#02123D"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "HostelKeep lets you choose a profile photo or hostel logo from your photos.",
          "cameraPermission": "HostelKeep uses your camera to take a profile photo or a photo for an extra-room request.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#02123D",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6FA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "d3e65e31-78d3-457a-843b-e82c9bbb4218"
      }
    },
    "owner": "tryout2000"
  }
}
