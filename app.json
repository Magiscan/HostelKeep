{
  "expo": {
    "version": "1.0.9",
    "name": "HostelKeep",
    "slug": "KeepCleanBlank",
    "orientation": "portrait",
    "scheme": "hostelkeep",
    "description": "Manage daily hostel room cleaning: assign rooms to cleaners, track progress in real time, and handle extra-room requests.",
    "primaryColor": "#2563EB",

    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keepclean",
      "buildNumber": "9",
      "infoPlist": {
        "NSCameraUsageDescription": "HostelKeep uses your camera so you can attach a photo of a room when requesting an extra cleaning.",
        "NSPhotoLibraryUsageDescription": "HostelKeep needs access to your photos so you can attach an existing photo to an extra-room request.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "versionCode": 9,
      "package": "com.keepclean",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },

    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },

    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "HostelKeep needs access to your photos so you can attach an existing photo to an extra-room request.",
          "cameraPermission": "HostelKeep uses your camera so you can attach a photo of a room when requesting an extra cleaning."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "f9873d21-3fa5-4cc1-b18c-d6c6f846511d"
      }
    }
  }
}